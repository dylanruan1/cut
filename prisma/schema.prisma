generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OWNER
  BARBER
  RECEPTIONIST
}

enum AppointmentStatus {
  CONFIRMED
  PENDING
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum DepositStatus {
  NONE
  PENDING
  PAID
  REFUNDED
  FAILED
}

/// Stripe Connect onboarding state for a shop's payout account.
enum ConnectStatus {
  NOT_CONNECTED
  PENDING
  ACTIVE
  RESTRICTED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum NotificationType {
  APPOINTMENT
  REMINDER
  SYSTEM
  INVITE
}

enum PhoneSetupMethod {
  NEW_TWILIO
  FORWARD_EXISTING
  PORT_TO_TWILIO
}

enum PhoneSetupStatus {
  NOT_STARTED
  PENDING
  CONNECTED
  ERROR
}

/// Lifecycle of a walk-in waiting for a chair.
enum QueueStatus {
  WAITING
  NOTIFIED
  IN_CHAIR
  DONE
  LEFT
}

/// How a completed walk-in paid. Cash is recorded, not processed, so the
/// queue advances the same way regardless of tender.
enum PaymentMethod {
  UNPAID
  CARD
  CASH
}

enum ShopPlan {
  NONE
  STARTER
  PRO
  AI_RECEPTIONIST
}

enum SubscriptionStatus {
  NONE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model Barbershop {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  address     String?
  phone       String?
  instagram   String?
  timezone    String   @default("America/Los_Angeles")
  /// Twilio number that receives inbound AI receptionist calls (E.164). Matched to Twilio "To".
  twilioPhone String?  @unique
  phoneSetupMethod PhoneSetupMethod?
  phoneSetupStatus PhoneSetupStatus @default(NOT_STARTED)
  phonePortingNotes String?

  /// Stripe Connect (Express) account that receives customer deposits.
  /// Deposits are destination charges — the money goes to the shop, not to Cut.
  stripeConnectAccountId String?       @unique
  connectStatus          ConnectStatus @default(NOT_CONNECTED)
  /// Master switch: shop must both connect payouts and enable deposits.
  depositsEnabled        Boolean       @default(false)

  /// SaaS plan for this shop. Defaults to NONE until checkout/trial.
  plan                 ShopPlan           @default(NONE)
  subscriptionStatus   SubscriptionStatus @default(NONE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?

  /// Set when an owner asks to delete the shop. The shop is NOT gone yet — a
  /// daily job hard-deletes it once the grace window passes (see
  /// src/lib/account-deletion.ts). Null means no deletion pending.
  deletionRequestedAt DateTime?
  /// User id that asked for deletion, kept so the audit trail survives support
  /// questions like "who killed our account".
  deletionRequestedBy String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users                    User[]
  memberships              BarbershopMembership[]
  barbers                  Barber[]
  services                 Service[]
  appointments             Appointment[]
  clients                  Client[]
  businessHours            BusinessHour[]
  holidays                 Holiday[]
  invitations              Invitation[]
  notifications            Notification[]
  smsLogs                  SmsLog[]
  receptionistCallSessions ReceptionistCallSession[]
  queueEntries             QueueEntry[]

  @@map("barbershops")
}

model User {
  id           String    @id
  email        String    @unique
  name         String?
  avatarUrl    String?
  /// Role for the currently selected (active) barbershop. Prefer membership.role for multi-shop.
  role         UserRole  @default(BARBER)
  /// Active / selected barbershop. Null until onboarding creates a shop.
  barbershopId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  barbershop  Barbershop?            @relation(fields: [barbershopId], references: [id], onDelete: SetNull)
  memberships BarbershopMembership[]
  barber      Barber?

  @@index([barbershopId])
  @@map("users")
}

/// Multi-shop membership — a user can belong to many barbershops.
model BarbershopMembership {
  id           String   @id @default(cuid())
  userId       String
  barbershopId String
  role         UserRole
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([userId, barbershopId])
  @@index([userId])
  @@index([barbershopId])
  @@map("barbershop_memberships")
}

model Barber {
  id           String   @id @default(cuid())
  userId       String?  @unique
  barbershopId String
  name         String
  email        String
  phone        String?
  photoUrl     String?
  color        String   @default("#007AFF")
  isActive     Boolean  @default(true)
  /// Bcrypt hash of the barber's 4-digit verification PIN. They memorise it and
  /// type it on the *customer's* phone to confirm a cash payment — no device or
  /// app needed at the station. Never stored or returned in plain text.
  verifyPinHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  barbershop      Barbershop      @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  workingHours    WorkingHour[]
  services        BarberService[]
  appointments    Appointment[]
  queueEntries    QueueEntry[]
  favoriteClients Client[]        @relation("FavoriteBarber")

  @@index([barbershopId])
  @@map("barbers")
}

model Service {
  id           String   @id @default(cuid())
  barbershopId String
  name         String
  description  String?
  duration     Int
  price        Decimal  @db.Decimal(10, 2)
  /// Optional upfront deposit required to book this service online.
  /// Null or 0 means no deposit. Only charged when the shop has payouts connected.
  depositAmount Decimal? @db.Decimal(10, 2)
  color        String   @default("#34C759")
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barbershop   Barbershop      @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barbers      BarberService[]
  appointments Appointment[]
  queueEntries QueueEntry[]

  @@index([barbershopId])
  @@map("services")
}

model BarberService {
  barberId  String
  serviceId String

  barber  Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@map("barber_services")
}

model Client {
  id               String    @id @default(cuid())
  barbershopId     String
  name             String
  phone            String
  email            String?
  notes            String?
  favoriteBarberId String?
  visitCount       Int       @default(0)
  lastVisitAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  barbershop     Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  favoriteBarber Barber?       @relation("FavoriteBarber", fields: [favoriteBarberId], references: [id], onDelete: SetNull)
  appointments   Appointment[]
  queueEntries   QueueEntry[]

  @@unique([barbershopId, phone])
  @@index([barbershopId, name])
  @@index([barbershopId, email])
  @@map("clients")
}

model Appointment {
  id            String            @id @default(cuid())
  barbershopId  String
  clientId      String
  barberId      String
  serviceId     String
  startTime     DateTime
  endTime       DateTime
  duration      Int
  notes         String?
  status        AppointmentStatus @default(PENDING)
  depositStatus DepositStatus     @default(NONE)
  depositAmount Decimal?          @db.Decimal(10, 2)
  /// Stripe objects for the deposit payment (destination charge on the shop's account).
  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String?
  /// While a deposit checkout is open the slot is held. Past this instant an
  /// unpaid hold is released so the time becomes bookable again.
  holdExpiresAt DateTime?
  /// Unguessable token letting a customer manage this booking without an
  /// account (sent in confirmation texts). Defaults to a random UUID in SQL.
  manageToken   String?   @unique
  source        String            @default("manual")
  /// Name given at booking time — prefer over client.name for display so history stays accurate.
  clientNameSnapshot  String?
  clientPhoneSnapshot String?
  clientEmailSnapshot String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  client     Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  barber     Barber     @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service    Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  smsLogs    SmsLog[]

  @@index([barbershopId, startTime])
  @@index([barberId, startTime])
  @@index([clientId])
  @@map("appointments")
  /// DATABASE-LEVEL DOUBLE-BOOKING GUARD (not managed by Prisma).
  /// Prisma cannot express Postgres exclusion constraints, so this is applied
  /// as raw SQL and must be re-applied to any freshly provisioned database:
  ///
  ///   CREATE EXTENSION IF NOT EXISTS btree_gist;
  ///   ALTER TABLE appointments
  ///     ADD CONSTRAINT appointments_no_double_booking
  ///     EXCLUDE USING gist (
  ///       "barberId" WITH =,
  ///       tsrange("startTime", "endTime") WITH &&
  ///     ) WHERE (status <> 'CANCELLED');
  ///
  /// Violations surface as SQLSTATE 23P01; see src/lib/booking-conflict.ts.
}

/// A walk-in waiting for a chair.
///
/// Designed so the queue advances without the barber touching anything:
/// checkout (card OR cash) completes an entry, and `autoCompleteAt` is a
/// timer backstop for when nobody taps anything at all.
model QueueEntry {
  id           String      @id @default(cuid())
  barbershopId String
  /// Set once the walk-in is linked to a known client (returning customer).
  clientId     String?
  serviceId    String
  /// Preferred barber; null means "anyone".
  barberId     String?
  name         String
  phone        String
  status       QueueStatus @default(WAITING)

  joinedAt     DateTime  @default(now())
  /// When we texted them that they're nearly up.
  notifiedAt   DateTime?
  /// When they actually sat down.
  seatedAt     DateTime?
  completedAt  DateTime?
  /// Timer backstop — past this the entry auto-completes so a cash-paying
  /// customer who never checks out can't jam the queue.
  autoCompleteAt DateTime?

  paymentMethod PaymentMethod @default(UNPAID)
  /// Amount actually collected (card or recorded cash), in dollars.
  paidAmount    Decimal?      @db.Decimal(10, 2)
  tipAmount     Decimal?      @db.Decimal(10, 2)
  stripePaymentIntentId String?
  /// False when someone self-reported cash without a barber confirming it.
  /// The visit still completes (the line must keep moving) but is flagged for
  /// the shop's end-of-day reconciliation and never rendered as a receipt.
  cashVerified  Boolean       @default(false)
  /// Which barber entered their PIN to confirm the cash, and when. Present
  /// only for genuinely verified payments — this is what the customer's screen
  /// displays, so it can't be reached by tapping alone.
  verifiedByBarberId String?
  verifiedAt         DateTime?

  /// Unguessable token for the customer's own status/checkout page.
  token        String   @unique @default(cuid())
  /// Links back to the appointment created when they're seated, if any.
  appointmentId String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  service    Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  barber     Barber?    @relation(fields: [barberId], references: [id], onDelete: SetNull)
  client     Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([barbershopId, status, joinedAt])
  @@index([barbershopId, joinedAt])
  @@map("queue_entries")
}

model BusinessHour {
  id           String  @id @default(cuid())
  barbershopId String
  dayOfWeek    Int
  openTime     String
  closeTime    String
  isClosed     Boolean @default(false)

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([barbershopId, dayOfWeek])
  @@map("business_hours")
}

model WorkingHour {
  id        String  @id @default(cuid())
  barberId  String
  dayOfWeek Int
  startTime String
  endTime   String
  isOff     Boolean @default(false)

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, dayOfWeek])
  @@map("working_hours")
}

model Holiday {
  id           String   @id @default(cuid())
  barbershopId String
  name         String
  date         DateTime @db.Date
  isClosed     Boolean  @default(true)

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId, date])
  @@map("holidays")
}

model Invitation {
  id           String           @id @default(cuid())
  barbershopId String
  email        String
  role         UserRole         @default(BARBER)
  token        String           @unique @default(cuid())
  status       InvitationStatus @default(PENDING)
  expiresAt    DateTime
  createdAt    DateTime         @default(now())

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
  @@map("invitations")
}

model Notification {
  id           String           @id @default(cuid())
  barbershopId String
  title        String
  message      String
  type         NotificationType @default(SYSTEM)
  isRead       Boolean          @default(false)
  metadata     Json?
  createdAt    DateTime         @default(now())

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId, createdAt])
  @@map("notifications")
}

model SmsLog {
  id            String   @id @default(cuid())
  barbershopId  String
  appointmentId String?
  to            String
  body          String
  type          String
  status        String   @default("sent")
  twilioSid     String?
  createdAt     DateTime @default(now())

  barbershop  Barbershop   @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([barbershopId, createdAt])
  @@map("sms_logs")
}

model PhoneBookingSession {
  id           String   @id @default(cuid())
  callSid      String   @unique
  barbershopId String?
  step         String   @default("menu")
  data         Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("phone_booking_sessions")
}

enum ReceptionistSessionStatus {
  ACTIVE
  AWAITING_CONFIRMATION
  COMPLETED
  CANCELLED
  EXPIRED
  FAILED
}

model ReceptionistCallSession {
  id            String                    @id @default(cuid())
  callSid       String                    @unique
  callerPhone   String
  barbershopId  String?
  intent        String?
  /// Name the CALLER gave (or explicitly confirmed) on THIS call. Never auto-filled from a matched Client.
  clientName    String?
  /// Phone-matched Client name offered to the caller ("Is this appointment under the name X?"). Suggestion only.
  suggestedClientName String?
  /// True once the caller has spoken a name or said yes to the suggested name on this call.
  confirmedClientName Boolean               @default(false)
  serviceName   String?
  barberName    String?
  preferredDate String?
  preferredTime String?
  awaitingField String?
  appointmentId String?
  status        ReceptionistSessionStatus @default(ACTIVE)
  turnCount     Int                       @default(0)
  context       Json                      @default("{}")
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  expiresAt     DateTime

  barbershop Barbershop? @relation(fields: [barbershopId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([callerPhone])
  @@index([barbershopId])
  @@map("receptionist_call_sessions")
}
