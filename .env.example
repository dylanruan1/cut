# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: exact Twilio webhook URL for signature validation (defaults to NEXT_PUBLIC_APP_URL + path)
# TWILIO_WEBHOOK_URL=https://your-app.vercel.app/api/twilio/voice

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Twilio (optional for local development — missing values will not crash the app)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890
# Optional: set during a zero-downtime auth token rotation. Webhook signatures
# are checked against both tokens, so add the new one here, promote it in
# Twilio, move it to TWILIO_AUTH_TOKEN, then remove this line.
# TWILIO_AUTH_TOKEN_SECONDARY=your-new-auth-token
# Optional but recommended for US SMS: send through the A2P 10DLC-registered
# Messaging Service so traffic is tied to your approved campaign.
# TWILIO_MESSAGING_SERVICE_SID=MG...

# AI Receptionist uses the same Twilio Voice webhooks:
#   POST /api/twilio/voice
#   POST /api/twilio/voice/process
# See docs/AI_RECEPTIONIST.md

# Cron (Vercel Cron Jobs)
CRON_SECRET=your-random-secret

# Stripe billing (optional locally — missing values will not crash the app)
# See docs/BILLING.md
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_AI_RECEPTIONIST_PRICE_ID=price_...
# Founding-shop AI plan (first 25 shops, locked for life). Falls back to
# STRIPE_AI_RECEPTIONIST_PRICE_ID when unset.
STRIPE_AI_FOUNDING_PRICE_ID=price_...
# Per-barber add-on charged above the seats included in Pro.
STRIPE_PER_BARBER_PRICE_ID=price_...
# Run `npm run setup-stripe-products` to create all five and print the IDs.

# Optional: platform fee on deposits, in basis points. Unset or 0 means Cut
# takes no cut — deposits settle straight to the shop's connected account.
# PLATFORM_FEE_BPS=0

# Optional: allow unmatched Twilio To to fall back to oldest shop in non-dev environments
# ALLOW_DEV_SHOP_FALLBACK=true

# AI receptionist brain
# Provider: "rules" (default regex parser) or "claude" (LLM brain).
# Set to "claude" AND provide ANTHROPIC_API_KEY to enable the smart receptionist.
# If Claude errors or the key is missing, the app automatically falls back to rules.
AI_RECEPTIONIST_PROVIDER=rules
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model (defaults to a fast, cheap Haiku model)
# AI_RECEPTIONIST_MODEL=claude-haiku-4-5-20251001

# Email delivery (Resend)
# Same key configured as Supabase Auth's custom SMTP password. Required for the
# /support form; without it messages are still stored but never delivered.
RESEND_API_KEY=re_...
# Must be on a domain verified in Resend, or sends are rejected.
EMAIL_FROM=Cut <noreply@cutchair.com>
# Where /support messages land. Replies go to whoever wrote in.
SUPPORT_INBOX=you@example.com
